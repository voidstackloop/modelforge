# OIDC identity provider issuer — the same IdP the ModelForge server (see
# server/.env.example's OIDC_ISSUER) validates tokens against.
VITE_OIDC_ISSUER=

# This console's own OAuth public client ID (Authorization Code + PKCE, no
# client secret), registered separately from the Electron app's client ID —
# same issuer, different app, different redirect_uri.
VITE_OIDC_CLIENT_ID=

# Optional. Only set if your IdP requires an explicit `audience` request
# parameter to mint a token with the right `aud` claim (Auth0-style
# tenants). The resulting token's `aud` must still equal the server's own
# OIDC_AUDIENCE regardless of how it gets there.
VITE_OIDC_AUDIENCE=

# Required. Base URL of the ModelForge IAM server, no trailing slash, e.g.
# https://iam.example-hospital.org. The server must have ADMIN_CONSOLE_ORIGIN
# set to this app's own deployed origin, or every request here will be
# blocked by the browser's CORS check — see server/.env.example.
VITE_API_BASE_URL=
