{
    "name": "modelforge-medical-iam-server",
    "version": "0.1.0",
    "private": true,
    "description": "Standalone IAM/policy-enforcement backend for ModelForge Medical enterprise deployments — generic-OIDC identity, AWS-IAM-style JSON policy documents, and an /authz/check primitive other services (a future shared patient-case backend, an admin console) call for every authorization decision. See docs/ENTERPRISE_MULTIUSER_ARCHITECTURE.md and this directory's README.md.",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "prebuild": "npm --prefix ../packages/contracts run build",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "build": "tsc",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "eval:clinical": "tsx src/eval-harness/cli.ts",
        "ops:canary": "node dist/ops/canary-cli.js",
        "ops:capacity": "node dist/ops/capacity-cli.js",
        "ops:rollout": "node dist/ops/rollout-cli.js",
        "ops:observe": "node dist/ops/post-shift-cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@modelforge/contracts": "file:../packages/contracts",
        "adm-zip": "file:vendor/adm-zip-disabled",
        "dcmjs": "^0.45.0",
        "dicom-parser": "^1.8.21",
        "fastify": "^5.6.1",
        "ioredis": "^5.11.1",
        "jose": "^6.1.0",
        "pg": "^8.13.1",
        "prom-client": "^15.1.3",
        "zod": "^4.4.3"
    },
    "overrides": {
        "adm-zip": "$adm-zip"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/pg": "^8.11.10",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^3.2.4"
    }
}
