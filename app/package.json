{
  "name": "app",
  "version": "1.4.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "npm --prefix ../packages/contracts run build",
    "postinstall": "node scripts/fix-native-permissions.js",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "dev:renderer": "npm --prefix ../frontend run dev",
    "dev:main": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist/main.js && cross-env NODE_ENV=development NODE_OPTIONS=--disable-warning=DEP0040 electron .",
    "dev": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "build:native": "npm --prefix ../lib install && npm --prefix ../lib run build",
    "build:mastervault": "npm --prefix ../mastervault-mcp-server install && npm --prefix ../mastervault-mcp-server run build:bundled",
    "build:all": "npm run build:native && npm run build:mastervault && npm --prefix ../frontend run build && npm run build",
    "package": "npm run build:all && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.modelforge.app",
    "productName": "Modelforge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "native/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/tesseract.js/**",
      "**/node_modules/tesseract.js-core/**",
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**",
      "**/node_modules/node-pty/**",
      "**/node_modules/better-sqlite3/**",
      "native/**"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "vendor/ohif-dist",
        "to": "ohif-dist"
      },
      {
        "from": "python",
        "to": "python"
      },
      {
        "from": "../mastervault-mcp-server/dist-bundled",
        "to": "mcp-servers/mastervault"
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "voidstackloop",
      "repo": "modelforge"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pidusage": "^2.0.5",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelforge/contracts": "file:../packages/contracts",
    "ajv": "^8.20.0",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "jose": "5.10.0",
    "node-llama-cpp": "^3.19.1",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "pidusage": "^4.0.1",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^5.1.1",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
